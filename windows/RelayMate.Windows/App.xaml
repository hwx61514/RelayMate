<Application
    x:Class="RelayMate.Windows.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Loads WinUI's default control styles and theme brushes, including
                     TextFillColorSecondaryBrush, card brushes, and text styles. -->
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="RelayMateSuccessBrush" Color="#107C10" />
            <SolidColorBrush x:Key="RelayMateWarningBrush" Color="#9D5D00" />
            <SolidColorBrush x:Key="RelayMateErrorBrush" Color="#C42B1C" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
