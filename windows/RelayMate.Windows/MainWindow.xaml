<Window
    x:Class="RelayMate.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="RelayMate">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid MaxWidth="760" Padding="28" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="5">
                <TextBlock Text="RelayMate" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="为 Claude Desktop、Claude Code 或 Codex 配置 API 中转线路。"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Border Grid.Row="1" Margin="0,22,0,0" Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="客户端" VerticalAlignment="Center" />
                    <ComboBox x:Name="ClientPicker" Grid.Column="1" MinWidth="220"
                              SelectionChanged="ClientPicker_SelectionChanged">
                        <ComboBoxItem Content="Claude Desktop 与 Claude Code" Tag="Claude" />
                        <ComboBoxItem Content="OpenAI Codex" Tag="Codex" />
                    </ComboBox>
                    <Button x:Name="RestoreButton" Grid.Column="2" Content="还原原配置"
                            Click="RestoreButton_Click" />
                </Grid>
            </Border>

            <StackPanel Grid.Row="2" Margin="0,20,0,0" Spacing="14">
                <TextBlock Text="中转线路" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBox x:Name="BaseUrlBox" Header="中转站 URL" PlaceholderText="https://relay.example.com/v1" />
                <PasswordBox x:Name="ApiKeyBox" Header="API Key" PlaceholderText="输入 API Key" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button x:Name="LoadModelsButton" Content="读取模型列表" Click="LoadModelsButton_Click" />
                    <ProgressRing x:Name="BusyRing" Width="22" Height="22" IsActive="False" Visibility="Collapsed" />
                </StackPanel>
            </StackPanel>

            <Grid Grid.Row="3" Margin="0,20,0,0" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="8">
                    <TextBlock Text="启用模型（可多选）" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <ListView x:Name="ModelsList" Height="190" SelectionMode="Multiple"
                              IsMultiSelectCheckBoxEnabled="True"
                              SelectionChanged="ModelsList_SelectionChanged" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="8">
                    <TextBlock Text="默认模型" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <ComboBox x:Name="DefaultModelPicker" HorizontalAlignment="Stretch" />
                    <TextBlock Text="Claude Desktop 仅接受 claude-sonnet-*、claude-opus-*、claude-haiku-*、claude-fable-*。"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" FontSize="12" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="4" Margin="0,20,0,0" Padding="12" CornerRadius="6"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon x:Name="StatusIcon" Glyph="&#xE946;" FontSize="16" />
                    <TextBlock x:Name="StatusText" Text="正在读取当前配置…" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="5" Margin="0,22,0,0" Orientation="Horizontal"
                        HorizontalAlignment="Right" Spacing="10">
                <Button Content="刷新状态" Click="RefreshButton_Click" />
                <Button x:Name="ApplyButton" Content="测试并应用" Style="{StaticResource AccentButtonStyle}"
                        Click="ApplyButton_Click" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
